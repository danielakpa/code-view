/* ==========================================
   CODEVIEW — GROUP WORKSPACE
   File: group_detail.css
========================================== */

/* ==========================================
   1. GENERAL WORKSPACE LAYOUT
========================================== */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #141518;
    color: #f3f4f6;
}

/* Divide the workspace into sidebar and main content. */
.workspace-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    height: calc(100dvh - 72px);
    min-height: 400px;
}

/* ==========================================
   2. LEFT SIDEBAR
========================================== */

.workspace-sidebar {
    padding: 25px 15px;
    background: #1b1c20;
    border-right: 1px solid #35363b;
    overflow-y: auto;
}

.sidebar-title {
    padding: 0 12px;
    margin-bottom: 20px;
    color: #9ca3af;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.sidebar-group-name {
    padding: 0 12px;
    margin-bottom: 12px;
    font-size: 17px;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.sidebar-group-description {
    padding: 0 12px;
    margin-bottom: 25px;
    color: #9ca3af;
    font-size: 12px;
    line-height: 1.6;
}

.sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    color: #b7bac3;
    text-decoration: none;
    border-radius: 9px;
    font-size: 14px;
    transition: background 0.2s;
}

.sidebar-link:hover {
    background: #2b2d32;
    color: #ffffff;
}

.sidebar-link.active {
    background: #173d2b;
    color: #4ade80;
    font-weight: 700;
}

.sidebar-divider {
    height: 1px;
    margin: 22px 0;
    background: #35363b;
}

.sidebar-admin-title {
    padding: 0 12px;
    margin-bottom: 12px;
    color: #9ca3af;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

.sidebar-admin-link {
    color: #fbbf24;
}

/* ==========================================
   3. MAIN WORKSPACE
========================================== */

.workspace-main {
    min-width: 0;
    overflow-y: auto;
    padding: 30px;
    background: #17181b;
}

.workspace-content {
    max-width: 1050px;
    margin: 0 auto;
}

.workspace-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 25px;
}

.workspace-heading h1 {
    margin: 0;
    font-size: 25px;
}

.workspace-subtitle {
    margin-top: 8px;
    color: #9ca3af;
    font-size: 14px;
}

/* ==========================================
   4. GROUP INFORMATION
========================================== */

.workspace-group-info {
    padding: 22px;
    margin-bottom: 24px;
    background: #232428;
    border: 1px solid #383a40;
    border-radius: 12px;
}

.workspace-group-info h2 {
    margin-top: 0;
    font-size: 19px;
}

.workspace-group-info p {
    color: #b7bac3;
    line-height: 1.7;
}

.workspace-group-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 15px;
    font-size: 12px;
    color: #9ca3af;
}

/* ==========================================
   5. DISCUSSION SECTIONS
========================================== */

.workspace-section {
    padding: 24px;
    margin-bottom: 24px;
    background: #232428;
    border: 1px solid #383a40;
    border-radius: 12px;
}

.workspace-section h2 {
    margin-top: 0;
    font-size: 19px;
}

.workspace-section-description {
    color: #9ca3af;
    font-size: 14px;
    line-height: 1.6;
}

.discussion-card {
    padding: 22px 0;
    border-bottom: 1px solid #383a40;
}

.discussion-card:last-child {
    border-bottom: none;
}

.discussion-author {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
}

.discussion-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #244c38;
    color: #86efac;
    border-radius: 50%;
    font-weight: 700;
}

.discussion-username {
    color: #4ade80;
    font-size: 13px;
    font-weight: 700;
}

.discussion-date {
    color: #858994;
    font-size: 12px;
}

.discussion-title {
    margin-bottom: 10px;
    font-size: 18px;
}

.discussion-title a {
    color: #f3f4f6;
    text-decoration: none;
}

.discussion-title a:hover {
    color: #4ade80;
}

.discussion-content {
    color: #b7bac3;
    font-size: 14px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

/* ==========================================
   6. DISCUSSION ACTIONS
========================================== */

.discussion-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 15px;
    color: #9ca3af;
    font-size: 13px;
}

.discussion-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
}

.discussion-actions form {
    margin: 0;
}

.like-button,
.comment-button,
.hide-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 14px;
    background: #303239;
    color: #d1d5db;
    border: 1px solid #41434a;
    border-radius: 8px;
    font-size: 13px;
    text-decoration: none;
    cursor: pointer;
}

.like-button:hover,
.comment-button:hover {
    background: #3b3e45;
}

.like-button.liked {
    background: #166534;
    color: #ffffff;
    border-color: #16a34a;
}

.like-button:disabled {
    opacity: 0.7;
    cursor: wait;
}

.hide-button:hover {
    background: #451f24;
    color: #fca5a5;
}

.like-error {
    color: #fca5a5;
    font-size: 13px;
}

/* ==========================================
   7. MEMBERSHIP STATUS
========================================== */

.membership-notice {
    padding: 20px;
    margin-bottom: 24px;
    background: #25272d;
    border: 1px solid #41434a;
    border-radius: 10px;
}

.membership-notice h2 {
    margin-top: 0;
}

.membership-notice p {
    color: #b7bac3;
    line-height: 1.6;
}

.membership-pending {
    display: inline-block;
    padding: 8px 12px;
    background: #453a1f;
    color: #fbbf24;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 700;
}

/* ==========================================
   8. GROUP MEMBERS
========================================== */

.workspace-members {
    margin-top: 20px;
}

.workspace-member {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #383a40;
}

.workspace-member:last-child {
    border-bottom: none;
}

.workspace-member small {
    display: block;
    margin-top: 4px;
    color: #9ca3af;
}

/* ==========================================
   9. RESPONSIVE DESIGN
========================================== */

@media (max-width: 750px) {

    .workspace-layout {
        grid-template-columns: 75px minmax(0, 1fr);
    }

    .workspace-sidebar {
        padding: 20px 8px;
    }

    .sidebar-title,
    .sidebar-group-name,
    .sidebar-group-description,
    .sidebar-link-text,
    .sidebar-admin-title {
        display: none;
    }

    .sidebar-link {
        justify-content: center;
        padding: 14px 8px;
        font-size: 20px;
    }

    .workspace-main {
        padding: 15px;
    }

    .workspace-section,
    .workspace-group-info {
        padding: 16px;
    }
}

/* Hide inactive workspace sections. */
[hidden] {
    display: none !important;
}

/* ==========================================
   10. GROUP CHAT WORKSPACE
   Keep the original CodeView chat design.
========================================== */

/*
   When Group Chat is active:
   - Remove the discussion card appearance.
   - Use the available workspace height.
   - Keep the message composer at the bottom.
*/

.workspace-main:has(#group-chat:not([hidden])) {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding: 0;
}

.workspace-main:has(#group-chat:not([hidden])) .workspace-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    max-width: none;
    min-height: 0;
    margin: 0;
}

/* Main chat container. */
#group-chat {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
    background: #17181b;
    border: none;
    border-radius: 0;
}

/* ==========================================
   11. CHAT HEADER
========================================== */

#group-chat .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 25px;
    border-bottom: 1px solid #35363b;
    flex-shrink: 0;
}

#group-chat .chat-header h2 {
    margin: 0;
    font-size: 19px;
    color: #f3f4f6;
}

#group-chat .chat-header p {
    margin: 6px 0 0;
    color: #9ca3af;
    font-size: 13px;
}

/* ==========================================
   12. CHAT MESSAGE HISTORY
========================================== */

#group-chat .chat-messages {
    flex: 1;
    min-height: 0;
    padding: 25px;
    overflow-y: auto;
}

/* Individual message. */
#group-chat .chat-message {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 13px 10px;
    margin-bottom: 5px;
    border-radius: 8px;
}

#group-chat .chat-message:hover {
    background: #202126;
}

/* Developer avatar. */
#group-chat .message-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 39px;
    flex-shrink: 0;
    background: #244c38;
    color: #86efac;
    border-radius: 50%;
    font-weight: 700;
}

/* Message content container. */
#group-chat .message-body {
    flex: 1;
    min-width: 0;
}

/* Developer name and message time. */
#group-chat .message-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 7px;
}

#group-chat .message-author {
    color: #4ade80;
    font-size: 14px;
    font-weight: 700;
}

#group-chat .message-time {
    color: #858994;
    font-size: 12px;
}

/* Normal text messages. */
#group-chat .message-content {
    color: #e5e7eb;
    font-size: 14px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

/* ==========================================
   13. MESSAGE REPLIES
========================================== */

#group-chat .message-reply {
    padding: 10px 12px;
    margin-bottom: 10px;
    background: #25272d;
    border-left: 3px solid #22c55e;
    border-radius: 5px;
    color: #d1d5db;
    font-size: 12px;
}

#group-chat .message-reply p {
    margin: 5px 0 0;
}

/* ==========================================
   14. CODE MESSAGES
========================================== */

#group-chat .message-code {
    padding: 16px;
    margin-top: 10px;
    background: #0f1117;
    border: 1px solid #343842;
    border-radius: 8px;
    color: #d1fae5;
    font-size: 13px;
    line-height: 1.6;
    overflow-x: auto;
}

#group-chat .code-language {
    margin-bottom: 8px;
    color: #4ade80;
    font-size: 12px;
}

/* ==========================================
   15. FILE AND VOICE MESSAGES
========================================== */

#group-chat .message-attachment {
    display: inline-block;
    margin-top: 10px;
    color: #86efac;
}

#group-chat .message-audio {
    display: block;
    max-width: 100%;
    margin-top: 10px;
}

/* ==========================================
   16. MESSAGE ACTIONS
========================================== */

#group-chat .message-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 10px;
}

#group-chat .message-actions button {
    padding: 0;
    background: transparent;
    border: none;
    color: #9296a1;
    font-size: 12px;
    cursor: pointer;
}

#group-chat .message-actions button:hover {
    color: #4ade80;
}

/* Empty chat message. */
#group-chat .chat-empty {
    padding: 60px 20px;
    color: #9ca3af;
    text-align: center;
}

/* ==========================================
   17. MESSAGE COMPOSER
========================================== */

/*
   The composer stays at the bottom because
   the chat uses a flex-column layout.

   Only the message history scrolls.
*/

#group-chat .chat-composer {
    padding: 18px 25px 25px;
    background: #17181b;
    border-top: 1px solid #35363b;
    flex-shrink: 0;
}


/* Main message input box. */
#group-chat .composer-box {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    padding: 12px;
    background: #26282d;
    border: 1px solid #41434a;
    border-radius: 12px;
}

/* Message textarea. */
#group-chat .composer-textarea {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    max-height: 150px;
    padding: 12px 5px;
    resize: vertical;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
}

#group-chat .composer-textarea::placeholder {
    color: #9ca3af;
}

/* File attachment input. */
#group-chat .composer-file-input {
    max-width: 220px;
    color: #d1d5db;
    font-size: 12px;
}

/* Microphone and send buttons. */
#group-chat .composer-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 39px;
    flex-shrink: 0;
    background: #383b42;
    border: none;
    border-radius: 9px;
    color: #e5e7eb;
    font-size: 19px;
    cursor: pointer;
}

#group-chat .composer-button:hover {
    background: #4b5563;
}

/* Send message button. */
#group-chat .composer-send {
    background: #16a34a;
    color: #ffffff;
}

#group-chat .composer-send:hover {
    background: #15803d;
}

/* Disabled microphone button. */
#group-chat .composer-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Form validation errors. */
#group-chat .composer-error {
    margin-bottom: 12px;
    color: #fca5a5;
    font-size: 13px;
}

/* ==========================================
   18. CHAT RESPONSIVE DESIGN
========================================== */

@media (max-width: 750px) {

    #group-chat .chat-header,
    #group-chat .chat-messages,
    #group-chat .chat-composer {
        padding-left: 12px;
        padding-right: 12px;
    }

    #group-chat .composer-box {
        flex-wrap: wrap;
    }

    #group-chat .composer-file-input {
        max-width: 100%;
    }


}

/* ==========================================
   19. SIMPLE CHAT COMPOSER
========================================== */

/* Hide the actual file input from the interface. */
#group-chat .composer-file-input {
    display: none;
}

/* Style the attachment button. */
#group-chat #attach-file-button {
    background: transparent;
    font-size: 22px;
}

#group-chat #attach-file-button:hover {
    background: #383b42;
}

/* Display the name of the selected file. */
#group-chat .selected-file-name {
    margin: 10px 0 0;
    color: #86efac;
    font-size: 12px;
    overflow-wrap: anywhere;
}

/* Highlight the message box when typing. */
#group-chat .composer-box:focus-within {
    border-color: #16a34a;
}

/* Keep the message input comfortable on smaller screens. */
@media (max-width: 750px) {

    #group-chat .composer-box {
        gap: 8px;
    }

    #group-chat .composer-button {
        width: 35px;
        height: 35px;
    }

    #group-chat .composer-textarea {
        padding: 9px 4px;
    }
}



/* ==========================================
   20. DARK MESSAGE EDIT AND DELETE PANELS
   Matches the CodeView workspace colors.
========================================== */

/* Hide inactive panels even if another style defines display. */
#group-chat .message-edit-form[hidden],
#group-chat .message-delete-form[hidden] {
    display: none !important;
}

#group-chat .message-edit-form,
#group-chat .message-delete-form {
    margin-top: 12px;
    padding: 15px;
    background: #202227;
    color: #e7e9ed;
    border: 1px solid #353942;
    border-radius: 10px;
}

/* Match the dark chat composer rather than browser-white inputs. */
#group-chat .message-edit-input {
    display: block;
    width: 100%;
    min-height: 85px;
    padding: 12px;
    background: #17191d;
    color: #f4f5f7;
    border: 1px solid #414650;
    border-radius: 8px;
    font: inherit;
    line-height: 1.5;
    resize: vertical;
}

#group-chat .message-edit-input:focus {
    outline: none;
    border-color: #22c76a;
    box-shadow: 0 0 0 3px rgba(34, 199, 106, 0.15);
}

#group-chat .message-edit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
}

#group-chat .edit-save-button,
#group-chat .edit-cancel-button,
#group-chat .delete-confirm-button,
#group-chat .delete-cancel-button {
    padding: 9px 16px;
    border: 1px solid transparent;
    border-radius: 8px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
}

#group-chat .edit-save-button {
    background: #159a51;
    color: #fff;
}

#group-chat .edit-cancel-button,
#group-chat .delete-cancel-button {
    background: #32363e;
    color: #e5e7eb;
    border-color: #474c55;
}

#group-chat .delete-confirm-button {
    background: #b73540;
    color: #fff;
}

#group-chat .edit-save-button:hover,
#group-chat .edit-cancel-button:hover,
#group-chat .delete-confirm-button:hover,
#group-chat .delete-cancel-button:hover {
    filter: brightness(1.12);
}

#group-chat .message-delete-form p {
    margin: 0;
    color: #f0d4d7;
}

#group-chat .message-deleted {
    color: #9da3ae;
    font-style: italic;
}

/* Hidden attachment field is triggered by the paperclip button. */
#group-chat .composer-file-input {
    display: none !important;
}

#group-chat .selected-file-name[hidden] {
    display: none !important;
}
/* ==========================================================
   CODEVIEW — ADD DEVELOPER & LIVE SEARCH
   ========================================================== */

/* Main section */
.add-member-section {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #38383e;
}

.add-member-section h3 {
    color: #f5f5f5;
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 16px;
}

/* Form layout */
.add-member-section form {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
}

/* Search container */
.developer-search-container {
    position: relative;
    flex: 1;
    min-width: 180px;
    max-width: 400px;
}

/* Search input */
#developer-search {
    width: 100%;
    height: 44px;
    padding: 0 14px;

    background: #19191d;
    color: #ffffff;

    border: 1px solid #414149;
    border-radius: 8px;

    font-size: 14px;
    outline: none;
    box-sizing: border-box;

    transition: border-color 0.2s, box-shadow 0.2s;
}

/* Placeholder */
#developer-search::placeholder {
    color: #8f9099;
}

/* Input focus */
#developer-search:focus {
    border-color: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
}

/* Search results dropdown */
.developer-search-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;

    z-index: 1000;

    background: #242428;
    border: 1px solid #414149;
    border-radius: 10px;

    max-height: 220px;
    overflow-y: auto;

    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

/* Hide dropdown when empty */
.developer-search-results:empty {
    display: none;
}

/* Individual developer result */
.developer-search-option {
    display: flex;
    align-items: center;

    width: 100%;
    min-height: 44px;
    padding: 12px 14px;

    background: transparent;
    color: #f5f5f5;

    border: none;
    border-bottom: 1px solid #35353b;

    font-size: 14px;
    text-align: left;
    cursor: pointer;

    transition: background 0.2s;
}

/* Remove last border */
.developer-search-option:last-child {
    border-bottom: none;
}

/* Hover and keyboard focus */
.developer-search-option:hover,
.developer-search-option:focus-visible {
    background: #174c37;
    color: #ffffff;
    outline: none;
}

/* Add Member button */
.add-member-section form > button[type="submit"] {
    height: 44px;
    padding: 0 20px;

    background: #16a34a;
    color: #ffffff;

    border: none;
    border-radius: 8px;

    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    transition: background 0.2s, transform 0.2s;
}

/* Button hover */
.add-member-section form > button[type="submit"]:hover {
    background: #15803d;
    transform: translateY(-1px);
}

/* Mobile responsiveness */
@media (max-width: 600px) {

    .add-member-section form {
        flex-direction: column;
        align-items: stretch;
    }

    .developer-search-container {
        width: 100%;
        max-width: 100%;
    }

    .add-member-section form > button[type="submit"] {
        width: 100%;
    }
}

/* ==========================================================
   CODEVIEW — MEMBER MANAGEMENT
   ========================================================== */

.member-role-btn,
.member-remove-btn,
.leave-group-btn {
    padding: 8px 12px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

/* Promote/demote */
.member-role-btn {
    background: #174c37;
    color: #4ade80;
    border: 1px solid #256b4c;
}

.member-role-btn:hover {
    background: #206447;
}

/* Remove member */
.member-remove-btn {
    background: #3b2025;
    color: #fca5a5;
    border: 1px solid #71343d;
}

.member-remove-btn:hover {
    background: #572b33;
}

/* Leave group */
.leave-group-section {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #38383e;
}

.leave-group-btn {
    background: transparent;
    color: #fca5a5;
    border: 1px solid #71343d;
}

.leave-group-btn:hover {
    background: #3b2025;
}
/* ========================================
   CODEVIEW REMOVE MEMBER MODAL
======================================== */

.codeview-modal[hidden] {
    display: none !important;
}

.codeview-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;
}

.codeview-modal-overlay {
    position: absolute;
    inset: 0;

    background: rgba(0, 0, 0, 0.75);
}

.codeview-modal-content {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: 420px;

    background: #15191f;
    border: 1px solid #30363d;
    border-radius: 14px;

    padding: 28px;

    color: #e6edf3;

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}

.codeview-modal-content h2 {
    margin: 0 0 14px;
    font-size: 22px;
    font-weight: 600;
}

.codeview-modal-content p {
    margin: 0;
    color: #9ca3af;
    font-size: 14px;
    line-height: 1.6;
}

.codeview-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;

    margin-top: 28px;
}

.modal-cancel-btn,
.modal-remove-btn {
    border: none;
    border-radius: 8px;

    padding: 11px 18px;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;
}

.modal-cancel-btn {
    background: #30363d;
    color: #e6edf3;
}

.modal-cancel-btn:hover {
    background: #414852;
}

.modal-remove-btn {
    background: #dc2626;
    color: white;
}

.modal-remove-btn:hover {
    background: #b91c1c;
}